# Ejecutables generados (por `go build`, `go install`, etc.)
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Directorio de dependencias externas (cuando se usa vendoring)
vendor/

# Cachés y archivos temporales de Go
*.log
*.tmp
*.temp

# Archivos de módulos si se genera el sum pero no se quiere versionar (opcional)
# go.sum

# Archivos del entorno de desarrollo
.idea/               # JetBrains (GoLand)
.vscode/            # Visual Studio Code
*.swp               # Vim
*.DS_Store          # macOS

# Archivos de cobertura (por ejemplo, generados por `go test -cover`)
coverage.out

# Carpeta bin en caso de compilar binarios localmente
bin/
